# extract <file> — unpack most common archive formats
if [[ ! -f "$1" ]]; then
  print -u2 "extract: '$1' is not a file"
  return 1
fi
case "$1" in
  *.tar.bz2|*.tbz2) tar xjf "$1" ;;
  *.tar.gz|*.tgz)   tar xzf "$1" ;;
  *.tar.xz|*.txz)   tar xJf "$1" ;;
  *.tar.zst)        tar --zstd -xf "$1" ;;
  *.tar)            tar xf  "$1" ;;
  *.bz2)            bunzip2 "$1" ;;
  *.gz)             gunzip  "$1" ;;
  *.xz)             unxz    "$1" ;;
  *.zst)            unzstd  "$1" ;;
  *.zip)            unzip   "$1" ;;
  *.rar)            unrar x "$1" ;;
  *.7z)             7z x    "$1" ;;
  *) print -u2 "extract: unsupported format '$1'"; return 1 ;;
esac
