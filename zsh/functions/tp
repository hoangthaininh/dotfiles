# tp [target] — one tmux session per project.
#
#   tp            fzf picker: live sessions (●) first, then git repos (○)
#   tp <dir>      session for that directory, created if it is not running
#   tp <name>     attach to a live session by exact name
#
# The layout is chosen from what this machine's shell history actually shows, not
# from what a tmux config usually looks like: git is 37% of every command typed,
# npm/pnpm 14%, and vim/nvim has never been run once — the editor here is VS Code,
# a GUI app. So there is no editor pane, and there is no four-pane grid:
#
#   dev   for the process that blocks a prompt — pnpm run dev, a watcher, a log
#   git   a free prompt, opened first, because that is where most commands go
#
# Anything more is one prefix+c or prefix+| away. A grid of panes that sits mostly
# idle is not a layout, it is furniture — and it costs screen height on every one.
#
# Session naming is basename-first, qualified by the parent only when two projects
# collide (Workspace holds cmp-sm-fe and cmp-sm-service side by side). The project
# directory is recorded in the @tp_dir session option, which is what makes a second
# `tp` on the same repo attach instead of building a duplicate.
#
# tmux target syntax, both load-bearing here:
#   - "=name" forces an exact match, so "cmp" cannot resolve to "cmp-sm-fe".
#   - Always brace ${name} before a ':' — zsh reads $name:r as a history modifier
#     and would turn "=$name:git" into something else entirely.

emulate -L zsh
setopt local_options extended_glob null_glob

(( $+commands[tmux] )) || { print -u2 "tp: tmux is not installed"; return 1 }

local target="${1:-}" dir="" name="" s g

# ── what is running, and which project each session belongs to ────────────────
local -A live_dir
for s in ${(f)"$(tmux list-sessions -F '#{session_name}' 2>/dev/null)"}; do
  live_dir[$s]="$(tmux show-option -qv -t "$s" '@tp_dir' 2>/dev/null)"
done

# ── resolve the target ────────────────────────────────────────────────────────
if [[ -z $target ]]; then
  local -a menu
  for s in ${(k)live_dir}; do
    menu+=( "● ${s}   ${${live_dir[$s]:-(not created by tp)}/#$HOME/~}" )
  done

  # Repos sit 3-5 levels below ~/Workspace, so a shallow scan finds nothing.
  for g in ${(f)"$(fd --hidden --glob '.git' --max-depth 7 \
                      --exclude node_modules --exclude .venv \
                      . "$HOME/Workspace" 2>/dev/null)"}; do
    dir="${${g%/}:h}"
    [[ -n ${live_dir[(r)$dir]:-} ]] && continue      # already open, listed above
    menu+=( "○ ${dir/#$HOME/~}" )
  done
  dir=""

  (( $#menu )) || { print -u2 "tp: no live sessions and no git repos under ~/Workspace"; return 1 }

  local pick
  pick=$(print -rl -- $menu | fzf --reverse --no-multi \
           --prompt='project ❯ ' --header='● live session    ○ project') || return 0
  [[ -n $pick ]] || return 0

  if [[ ${pick[1]} == "●" ]]; then
    name="${${pick#● }%% *}"
  else
    dir="${${${pick#○ }%% *}/#\~/$HOME}"
  fi

elif (( ${+live_dir[$target]} )); then
  name=$target
elif [[ -d $target ]]; then
  dir=$target
else
  print -u2 "tp: no live session and no directory matching '${target}'"
  return 1
fi

# ── derive a collision-free session name ──────────────────────────────────────
if [[ -n $dir ]]; then
  dir=${dir:A}                                        # absolute, symlinks resolved
  name=${dir:t}

  # Qualify with the parent directory only when another project already owns the
  # bare name; two levels is enough for this tree, and a third collision is a
  # naming problem worth hearing about rather than papering over.
  if [[ -n ${live_dir[$name]:-} && ${live_dir[$name]} != $dir ]]; then
    name="${${dir:h}:t}_${name}"
    if [[ -n ${live_dir[$name]:-} && ${live_dir[$name]} != $dir ]]; then
      print -u2 "tp: '${name}' is taken by another project — rename one, or: ta <name>"
      return 1
    fi
  fi
fi
[[ -n $name ]] || { print -u2 "tp: could not derive a session name"; return 1 }

# ── create it if it is not running ────────────────────────────────────────────
if ! tmux has-session -t "=${name}" 2>/dev/null; then
  [[ -n $dir ]] || { print -u2 "tp: session '${name}' is gone and no directory was given"; return 1 }

  tmux new-session -d -s "$name" -c "$dir" -n dev || return 1
  tmux set-option -t "$name" '@tp_dir' "$dir"        # how the next tp finds this
  tmux new-window  -t "=${name}:" -c "$dir" -n git
  tmux select-window -t "=${name}:git"               # land where the typing happens
fi

# ── attach, or switch if we are already inside tmux ───────────────────────────
if [[ -n ${TMUX:-} ]]; then
  tmux switch-client -t "=${name}"
else
  tmux attach-session -t "=${name}"
fi
